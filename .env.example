# Copy to .env and fill in. .env is gitignored.

# Coinalyze API key (free tier — register at https://coinalyze.net/).
# Used by fetch_coinalyze.py for the one-shot LSR history fetch during
# bootstrap or to fill historical gaps that Binance won't serve (>30d).
# Not needed for ongoing live operation.
COINALYZE_API_KEY=

# MEXC credentials — NOT USED in shadow/paper mode. The bot writes phantom
# trades to data/dashboard.db only. Keys are included here so a future
# primary-promotion path has a place to plug in without schema churn.
MEXC_API_KEY=
MEXC_SECRET=

# services/news_fetcher.py pulls headlines from a hand-picked list of
# reputable RSS feeds (CoinDesk, The Block, Decrypt, Bitcoin Magazine,
# BBC Business, CNBC). RSS is static XML — no auth tokens, no rate
# limits, no third-party aggregator. The default source list lives in
# services/news_fetcher.py:SOURCES; edit it there to add or drop a feed.
# (No env var needed for news ingest.)

# Anthropic API key for the AI_QUANT sleeve's daily decision call.
# claude-opus-4-7 (default) at ~$0.50–$2 per decision with prompt caching.
# Without this, the sleeve refuses to fire. Cap daily spend with
# AI_QUANT_DAILY_COST_CAP_USD (default 5.0).
ANTHROPIC_API_KEY=
AI_QUANT_MODEL=claude-opus-4-7
AI_QUANT_DAILY_COST_CAP_USD=5.0
AI_QUANT_ENABLED=false
